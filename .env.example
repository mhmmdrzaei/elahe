# Sanity — from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Contact form (https://resend.com). If CONTACT_TO_EMAIL is empty,
# messages go to the email set on the Contact page in Sanity.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=
